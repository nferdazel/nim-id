#!/usr/bin/env sh
#
# nim-id — single entry point for all commands.
#
#   ./task examples  compile and verify every example (needs Nim 2.2.12)
#   ./task site      render Indonesian + English, assemble public/
#   ./task id        render the Indonesian edition only
#   ./task en        render the English edition only (Quarto profile `en`)
#   ./task pdf       render the PDF edition of both books
#   ./task dev       local preview with auto-reload
#   ./task check     examples + site (the gate before a commit)
#   ./task version   print the version from VERSION
#   ./task release   bump the version from commit messages, commit, and tag
#   ./task help
#
# Plain POSIX shell, not a Taskfile/just: no new tooling, and the same command runs on a
# laptop and in CI — the same pattern as the cbs repository (D-001 there).
#
# Indonesian aliases are kept for muscle memory: contoh, versi, rilis.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT"

QUARTO=${QUARTO:-quarto}

usage() {
  cat <<'TXT'
usage: ./task <command>

  examples  compile and verify every example (needs Nim 2.2.12)
  site      render Indonesian + English, assemble public/
  id        render the Indonesian edition only
  en        render the English edition only
  pdf       render the PDF edition of both books
  dev       local preview with auto-reload
  check     examples + appendix + site (the gate before a commit)
  version   print the book version (from VERSION)
  release   bump the version from commit messages, commit, then tag (--major/--minor/--patch)

environment:
  QUARTO   path to the quarto binary (default: quarto from PATH)
  NIM      path to the nim binary (default: nim from PATH)
TXT
}

perlu() {
  command -v "$1" >/dev/null 2>&1 || { echo "requires '$1' on PATH" >&2; exit 1; }
}

case "${1:-help}" in
  examples | contoh)
    perlu nim
    bash tools/verify-examples.sh
    ;;
  site)
    perlu "$QUARTO"
    QUARTO="$QUARTO" bash tools/build-site.sh
    ;;
  id)
    perlu "$QUARTO"
    sh tools/gen-version.sh
    sh tools/sync-assets.sh
    "$QUARTO" render books/id
    ;;
  en)
    perlu "$QUARTO"
    sh tools/gen-version.sh
    sh tools/sync-assets.sh
    "$QUARTO" render books/en
    ;;
  pdf)
    perlu "$QUARTO"
    sh tools/gen-version.sh
    sh tools/sync-assets.sh
    "$QUARTO" render books/id --to typst
    "$QUARTO" render books/en --to typst
    ;;
  dev)
    perlu "$QUARTO"
    "$QUARTO" preview
    ;;
  version | versi)
    tr -d '[:space:]' < VERSION
    echo
    ;;
  release | rilis)
    shift
    perlu git
    sh tools/release.sh "$@"
    ;;
  check)
    perlu nim
    perlu "$QUARTO"
    perlu python3
    python3 tools/lint-glossary.py
    python3 tools/check-parity.py
    python3 tools/check-glossary-page.py
    bash tools/verify-examples.sh
    python3 tools/check-appendix.py
    QUARTO="$QUARTO" bash tools/build-site.sh
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $1" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
